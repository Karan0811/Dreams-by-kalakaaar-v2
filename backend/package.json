{
  "name": "@dreams-by-kalakaaar/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Dreams by Kalakaaar v2 — backend (Next.js 15 Route Handlers, Drizzle ORM, Better Auth). Implements 10-backend-architecture.md Phase 1.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:demo": "tsx src/scripts/seed-demo-data.ts",
    "db:studio": "drizzle-kit studio",
    "boundaries:check": "eslint . --rule '{\"import/no-restricted-paths\":\"error\"}'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.716.0",
    "@aws-sdk/s3-request-presigner": "3.716.0",
    "@node-rs/argon2": "2.0.2",
    "@sentry/nextjs": "8.47.0",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.34.3",
    "better-auth": "1.1.13",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.38.3",
    "jose": "5.9.6",
    "js-yaml": "^5.2.2",
    "nanoid": "5.0.9",
    "next": "15.5.22",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0",
    "postgres": "3.4.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "@vitejs/plugin-react": "4.3.4",
    "drizzle-kit": "0.30.1",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.22",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
