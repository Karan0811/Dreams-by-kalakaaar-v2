# Dreams by Kalakaaar v2 — Backend Environment Variables
# Copy to .env.local for local development. Never commit a real .env file.
# See 10-backend-architecture.md Section 23 (Configuration) and
# Section 17.6 (Secrets Management) for the architectural rationale.

# ── Application ──────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Dreams by Kalakaaar"

# ── Database (Supabase PostgreSQL via Drizzle ORM) ──────────────────────
# Local development uses the Postgres container in scripts/docker-compose.yml.
# Production points at the Supabase project's pooled connection string
# (10-backend-architecture.md Section 10.8 — pgBouncer transaction pooling).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dreams_by_kalakaaar
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Supabase project (used for Realtime, Storage fallback, and RLS-aware admin ops)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# ── Authentication (Better Auth — 10-backend-architecture.md Section 7) ─
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Asymmetric signing key pair for access-token JWTs (Section 3.1 of
# 09-api-architecture.md — access tokens are verifiable without a DB round trip)
JWT_PRIVATE_KEY=replace-with-pem-encoded-private-key
JWT_PUBLIC_KEY=replace-with-pem-encoded-public-key
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# OAuth providers (readiness only at launch — Section 7.8)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Cache & Rate Limiting (Upstash Redis — Section 13) ──────────────────
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token

# ── File Storage (Cloudflare R2 — Section 11, S3-compatible API) ────────
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=dreams-by-kalakaaar-media
R2_PUBLIC_URL=https://media.dreamsbykalakaaar.com

# ── Email (Section 15.1) ───────────────────────────────────────────────
# Email provider: 'resend' or 'gmail'
EMAIL_PROVIDER=resend

# Resend configuration
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL="Dreams by Kalakaaar <no-reply@dreamsbykalakaaar.com>"

# Gmail SMTP configuration (when EMAIL_PROVIDER=gmail)
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# ── Payments (Razorpay — Section 16) ─────────────────────────────────────
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# ── Background Jobs (Inngest — Section 12) ──────────────────────────────
INNGEST_EVENT_KEY=replace-me
INNGEST_SIGNING_KEY=replace-me

# ── Observability (Section 19) ───────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Rate Limiting Tiers (Section 8.3 of 12-security-architecture.md) ────
RATE_LIMIT_AUTH_PER_IP=5
RATE_LIMIT_AUTH_PER_ACCOUNT=5
RATE_LIMIT_STANDARD_PER_ACCOUNT=100
RATE_LIMIT_PUBLIC_PER_IP=60
