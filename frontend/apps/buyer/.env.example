# Upstream REST API (server-only; consumed by @dbk/api-client's apiFetch)
API_BASE_URL="https://api.dreamsbykalakaaar.com"

# Better Auth (packages/auth)
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"
BETTER_AUTH_URL="http://localhost:3002"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3002,http://localhost:3001"
DATABASE_URL="postgresql://user:password@localhost:5432/dreams_by_kalakaaar"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public (browser-exposed)
NEXT_PUBLIC_APP_URL="http://localhost:3002"
NEXT_PUBLIC_CREATOR_APP_URL="http://localhost:3001"
NEXT_PUBLIC_API_BASE_URL="https://api.dreamsbykalakaaar.com"

# Upstash Redis (rate limiting — used server-side only)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Razorpay (checkout, later sprint)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Sentry / PostHog
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
